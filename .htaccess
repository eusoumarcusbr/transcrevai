# TranscrevAI: cabeçalhos necessários para o processamento no navegador
# (isolamento de origem libera vários núcleos do processador no modo sem WebGPU)
<IfModule mod_headers.c>
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"
  Header always set X-Content-Type-Options "nosniff"
  # bibliotecas e .wasm quase nunca mudam: cache longo
  <FilesMatch "\.(wasm|mjs|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # o código do site muda: sempre revalidar, senão o navegador (principalmente
  # no celular) fica preso numa versão antiga depois de uma atualização
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # os modelos espelhados nunca mudam de conteúdo: cache longo
  <FilesMatch "\.onnx$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # o zip da extensão BaixaAI: troca pouco, mas precisa revalidar quando troca
  <FilesMatch "\.zip$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
  AddType application/zip .zip
  AddType application/octet-stream .onnx
  AddType application/wasm .wasm
  AddType text/javascript .mjs .js
</IfModule>
Options -Indexes
